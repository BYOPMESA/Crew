# Copy to .env (git-ignored) and fill in. Never commit real values.

PORT=3003

# Supabase project (Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key - safe for the API server to hold, used with the user's JWT so RLS applies.
SUPABASE_ANON_KEY=sb_publishable_...
# Service-role key - SERVER ONLY. Needed for invite acceptance, background jobs and email. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed app (used in invite links)
CREW_PUBLIC_URL=http://localhost:3003
# Set to 1 in production (HTTPS only cookies + HSTS)
COOKIE_SECURE=0

# Later phases (not read yet)
# ANTHROPIC_API_KEY=
# CREW_EMAIL_API_KEY=
# CREW_EMAIL_FROM=
