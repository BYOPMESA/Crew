# Copy to .env.test (git-ignored) and fill in. Used only by `npm run test:live`.
# Create these two users in the Supabase dashboard (Authentication > Users > Add user, tick "Auto Confirm User").
# Use addresses you own. Never commit .env.test and never paste these values into chat.
TEST_EMAIL_A=
TEST_PASSWORD_A=
TEST_EMAIL_B=
TEST_PASSWORD_B=
# Base URL of a RUNNING server (npm start)
TEST_BASE_URL=http://localhost:3003
